generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HabitCategory {
  coding
  reading
  gym
  running
  meditation
  fasting
  custom
}

enum CheckInStatus {
  pending
  verified
  rejected
}

enum ShieldTier {
  bronze
  silver
  gold
}

enum ShieldStatus {
  active
  expired
  consumed
}

enum AppRole {
  user
  moderator
  admin
}

enum FriendStatus {
  pending
  accepted
  blocked
}

enum MentorshipStatus {
  pending
  active
  declined
  ended
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile           Profile?
  roles             UserRole[]
  habits            Habit[]
  checkIns          CheckIn[]
  creditBalances    CreditBalance[]
  creditTxns        CreditTransaction[]
  shields           Shield[]
  badges            Badge[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]

  sentFriendReqs    Friendship[] @relation("FriendFrom")
  recvFriendReqs    Friendship[] @relation("FriendTo")

  clubMemberships   ClubMember[]
  clubsCreated      Club[]       @relation("ClubCreator")
  clubMessages      ClubMessage[]

  dmsSent           DirectMessage[] @relation("DmFrom")
  dmsRecv           DirectMessage[] @relation("DmTo")

  mentorshipsAsMentor   Mentorship[] @relation("Mentor")
  mentorshipsAsMentee   Mentorship[] @relation("Mentee")

  blocksMade        Block[] @relation("Blocker")
  blocksReceived    Block[] @relation("Blocked")

  reportsMade       Report[] @relation("Reporter")
  reportsReceived   Report[] @relation("Reported")
}

model Profile {
  id                   String   @id
  user                 User     @relation(fields: [id], references: [id], onDelete: Cascade)
  username             String   @unique
  displayName          String
  bio                  String?
  avatarUrl            String?
  level                Int      @default(1)
  xp                   Int      @default(0)
  currentStreak        Int      @default(0)
  longestStreak        Int      @default(0)
  consistencyScore     Int      @default(0)
  verificationAccuracy Int      @default(0)
  dmEnabled            Boolean  @default(true)
  mentorAvailable      Boolean  @default(false)
  mentorBio            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model UserRole {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AppRole @default(user)

  @@unique([userId, role])
}

model Habit {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    HabitCategory
  description String?
  icon        String?
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  checkIns    CheckIn[]

  @@index([userId, archived])
}

model CheckIn {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId            String
  habit              Habit         @relation(fields: [habitId], references: [id], onDelete: Cascade)
  category           HabitCategory
  checkDate          DateTime      @db.Date
  status             CheckInStatus @default(pending)
  verificationScore  Int?
  confidenceScore    Int?
  creditsAwarded     Int           @default(0)
  proofData          Json?
  aiFeedback         Json?
  createdAt          DateTime      @default(now())

  @@unique([habitId, checkDate])
  @@index([userId, checkDate])
}

model CreditBalance {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       HabitCategory
  balance        Int           @default(0)
  lifetimeEarned Int           @default(0)
  updatedAt      DateTime      @updatedAt

  @@unique([userId, category])
}

model CreditTransaction {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  HabitCategory
  amount    Int
  reason    String
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
}

model Shield {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     HabitCategory
  tier         ShieldTier
  cost         Int
  protectsDays Int
  status       ShieldStatus  @default(active)
  purchasedAt  DateTime      @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([userId, status])
}

model Badge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey  String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeKey])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Friendship {
  id        String       @id @default(uuid())
  fromId    String
  from      User         @relation("FriendFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User         @relation("FriendTo", fields: [toId], references: [id], onDelete: Cascade)
  status    FriendStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([fromId, toId])
  @@index([toId, status])
}

model Club {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  description   String?
  category      HabitCategory?
  minStreak     Int           @default(0)
  creatorId     String
  creator       User          @relation("ClubCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  isPrivate     Boolean       @default(false)
  createdAt     DateTime      @default(now())

  members       ClubMember[]
  messages      ClubMessage[]
}

model ClubMember {
  id       String   @id @default(uuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin  Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
}

model ClubMessage {
  id        String   @id @default(uuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

model DirectMessage {
  id        String   @id @default(uuid())
  fromId    String
  from      User     @relation("DmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("DmTo", fields: [toId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}

model Mentorship {
  id        String           @id @default(uuid())
  mentorId  String
  mentor    User             @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId  String
  mentee    User             @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)
  status    MentorshipStatus @default(pending)
  message   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([mentorId, menteeId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId  String
  reported    User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason      String
  context     String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
