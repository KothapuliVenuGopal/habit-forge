# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,https://your-frontend.lovable.app

# --- Database (Render Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/consitrack?sslmode=require

# --- Auth ---
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# --- AI Verification (optional; falls back to heuristic) ---
LOVABLE_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# --- Email (optional, for password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ConsiTrack <noreply@consitrack.app>
